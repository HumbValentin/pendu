<Window x:Class="pendu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pendu"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Foreground="White">

    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="/Resource/BackGround/1_Back_Hollow.png"
                Stretch="UniformToFill"
                AlignmentX="Center"
                AlignmentY="Center"/>
        </Grid.Background>

        <!--<Image x:Name="ImageHollow"
           Source="/Resource/BackGround/1_Back_Hollow.png"
           Stretch="UniformToFill"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>-->
        <!--<Grid.Background>
            <Image x:Name="ImageHollow" HorizontalAlignment="Center" VerticalAlignment="Center" Height="236" Source="/Resource/BackGround/1_Back_Hollow.png"/>
        </Grid.Background>-->

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>

                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="1" Name="BTN_A" Content="A" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="0" Grid.Column="2" Name="BTN_B" Content="B" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="0" Grid.Column="3" Name="BTN_C" Content="C" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="0" Grid.Column="4" Name="BTN_D" Content="D" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="0" Grid.Column="5" Name="BTN_E" Content="E" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="0" Grid.Column="6" Name="BTN_F" Content="F" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>

                <Button Grid.Row="1" Grid.Column="1" Name="BTN_G" Content="G" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="1" Grid.Column="2" Name="BTN_H" Content="H" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="1" Grid.Column="3" Name="BTN_I" Content="I" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="1" Grid.Column="4" Name="BTN_J" Content="J" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="1" Grid.Column="5" Name="BTN_K" Content="K" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="1" Grid.Column="6" Name="BTN_L" Content="L" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>

                <Button Grid.Row="2" Grid.Column="1" Name="BTN_M" Content="M" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="2" Grid.Column="2" Name="BTN_N" Content="N" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="2" Grid.Column="3" Name="BTN_O" Content="O" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="2" Grid.Column="4" Name="BTN_P" Content="P" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="2" Grid.Column="5" Name="BTN_Q" Content="Q" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="2" Grid.Column="6" Name="BTN_R" Content="R" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>

                <Button Grid.Row="3" Grid.Column="1" Name="BTN_S" Content="S" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="3" Grid.Column="2" Name="BTN_T" Content="T" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="3" Grid.Column="3" Name="BTN_U" Content="U" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="3" Grid.Column="4" Name="BTN_V" Content="V" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="3" Grid.Column="5" Name="BTN_W" Content="W" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="3" Grid.Column="6" Name="BTN_X" Content="X" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>

                <Button Grid.Row="4" Grid.Column="4" Name="BTN_Y" Content="Y" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
                <Button Grid.Row="4" Grid.Column="5" Name="BTN_Z" Content="Z" Background="Transparent" Foreground="Transparent" BorderBrush="Transparent" Click="BTN_Click"/>
            </Grid>

        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="192"/>
                    <ColumnDefinition Width="118"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="1" Grid.Column="1" Name="BTN_Valid" Content="Valid" BorderBrush="Transparent" Foreground="Transparent" Background="Transparent" Click="BTN_Valid_Click"/>

            </Grid>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="68"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="1" Grid.Column="1" Name="BTN_Compte" Content="Essai" BorderBrush="Transparent" Foreground="White" Background="Transparent" Click="BTN_Compte_Click"/>

            </Grid>


        </Grid>

    </Grid>

</Window>
