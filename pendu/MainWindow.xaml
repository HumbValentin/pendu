<Window x:Class="pendu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pendu"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Foreground="White">

    <Grid x:Name="MainGrid">

        <Grid.Background>
            <ImageBrush ImageSource="/Resource/BackGround/1_Back_Hollow.png"
                Stretch="UniformToFill"
                AlignmentX="Center"
                AlignmentY="Center"/>
        </Grid.Background>

        <Grid.Resources>
            <Style x:Key="GreenButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#0A636B"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="BorderBrush" Value="#81A198"/>
                <Setter Property="BorderThickness" Value="4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                                <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3CB371"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1E5631"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#808080"/>
                                    <Setter Property="Foreground" Value="#D3D3D3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ValidStyle" TargetType="Button">
                <Setter Property="Background" Value="#D7D7D9"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="BorderBrush" Value="#81A198"/>
                <Setter Property="BorderThickness" Value="4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20">
                                <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3CB371"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1E5631"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#808080"/>
                                    <Setter Property="Foreground" Value="#D3D3D3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


        </Grid.Resources>





        <!--<Image x:Name="ImageHollow"
           Source="/Resource/BackGround/1_Back_Hollow.png"
           Stretch="UniformToFill"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>-->
        <!--<Grid.Background>
            <Image x:Name="ImageHollow" HorizontalAlignment="Center" VerticalAlignment="Center" Height="236" Source="/Resource/BackGround/1_Back_Hollow.png"/>
        </Grid.Background>-->

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="1" Name="BTN_A" Content="A" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="0" Grid.Column="2" Name="BTN_B" Content="B" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="0" Grid.Column="3" Name="BTN_C" Content="C" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="0" Grid.Column="4" Name="BTN_D" Content="D" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="0" Grid.Column="5" Name="BTN_E" Content="E" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="0" Grid.Column="6" Name="BTN_F" Content="F" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>

                <Button Grid.Row="1" Grid.Column="1" Name="BTN_G" Content="G" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="1" Grid.Column="2" Name="BTN_H" Content="H" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="1" Grid.Column="3" Name="BTN_I" Content="I" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="1" Grid.Column="4" Name="BTN_J" Content="J" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="1" Grid.Column="5" Name="BTN_K" Content="K" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="1" Grid.Column="6" Name="BTN_L" Content="L" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>

                <Button Grid.Row="2" Grid.Column="1" Name="BTN_M" Content="M" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="2" Grid.Column="2" Name="BTN_N" Content="N" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="2" Grid.Column="3" Name="BTN_O" Content="O" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="2" Grid.Column="4" Name="BTN_P" Content="P" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="2" Grid.Column="5" Name="BTN_Q" Content="Q" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="2" Grid.Column="6" Name="BTN_R" Content="R" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>

                <Button Grid.Row="3" Grid.Column="1" Name="BTN_S" Content="S" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="3" Grid.Column="2" Name="BTN_T" Content="T" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="3" Grid.Column="3" Name="BTN_U" Content="U" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="3" Grid.Column="4" Name="BTN_V" Content="V" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="3" Grid.Column="5" Name="BTN_W" Content="W" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="3" Grid.Column="6" Name="BTN_X" Content="X" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>

                <Button Grid.Row="4" Grid.Column="4" Name="BTN_Y" Content="Y" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
                <Button Grid.Row="4" Grid.Column="5" Name="BTN_Z" Content="Z" Style="{StaticResource GreenButtonStyle}" Click="BTN_Click"/>
            </Grid>



        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="192"/>
                    <ColumnDefinition Width="118"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Button Grid.Row="1" Grid.Column="1" Name="BTN_Valid" Content="Valid" Style="{StaticResource ValidStyle}" Click="BTN_Valid_Click"/> -->

            </Grid>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="5"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Button Grid.Column="1" Name="BTN_Compte" Content="Essai :" BorderBrush="Transparent" Foreground="#0A636B" Background="Transparent" Click="BTN_Compte_Click" Margin="0,42,0,0" Grid.RowSpan="2"/>
                <TextBox Grid.Column="0" Name="TB_Display" BorderBrush="Transparent" Foreground="LightGray" Background="Transparent" FontSize="30" TextAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" IsReadOnly="True" Grid.RowSpan="2" Height="70" Margin="-51,0,0,0"/>
                <TextBox Grid.Column="1" Name="TB_Compte" Text="8" BorderBrush="Transparent" Foreground="#0A636B" Background="Transparent" FontSize="20" FontWeight="Bold" TextAlignment="Left" VerticalAlignment="Top" IsReadOnly="True" Margin="33,14,2,0" Grid.Row="1" Grid.ColumnSpan="3"/>



            </Grid>


        </Grid>

    </Grid>

</Window>
