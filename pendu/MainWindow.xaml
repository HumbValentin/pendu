                <Button Grid.Row="2" Grid.Column="3" Name="BTN_O" Content="O" Background="Transparent" Click="BTN_Click" Grid.ColumnSpan="2" Margin="0,0,2,0"/>
                <Button Grid.Row="2" Grid.Column="4" Name="BTN_P" Content="P" Background="Transparent" Click="BTN_Click" Grid.ColumnSpan="3" Margin="1,0,57,0"/>
