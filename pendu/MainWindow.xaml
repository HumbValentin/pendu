<Window x:Class="pendu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pendu"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="1">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="35"/>

                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="1" Name="BTN_A" Content="A" />
                <Button Grid.Row="0" Grid.Column="2" Name="BTN_B" Content="B" />
                <Button Grid.Row="0" Grid.Column="3" Name="BTN_C" Content="C" />
                <Button Grid.Row="0" Grid.Column="4" Name="BTN_D" Content="D" />
                <Button Grid.Row="0" Grid.Column="5" Name="BTN_E" Content="E" />
                <Button Grid.Row="0" Grid.Column="6" Name="BTN_F" Content="F" />
                
                <Button Grid.Row="1" Grid.Column="1" Name="BTN_G" Content="G" />
                <Button Grid.Row="1" Grid.Column="2" Name="BTN_H" Content="H" />
                <Button Grid.Row="1" Grid.Column="3" Name="BTN_I" Content="I" />
                <Button Grid.Row="1" Grid.Column="4" Name="BTN_J" Content="J" />
                <Button Grid.Row="1" Grid.Column="5" Name="BTN_K" Content="K" />
                <Button Grid.Row="1" Grid.Column="6" Name="BTN_L" Content="L" />
                
                <Button Grid.Row="2" Grid.Column="1" Name="BTN_M" Content="M" />
                <Button Grid.Row="2" Grid.Column="2" Name="BTN_N" Content="N" />
                <Button Grid.Row="2" Grid.Column="3" Name="BTN_O" Content="O" />
                <Button Grid.Row="2" Grid.Column="4" Name="BTN_P" Content="P" />
                <Button Grid.Row="2" Grid.Column="5" Name="BTN_Q" Content="Q" />
                <Button Grid.Row="2" Grid.Column="6" Name="BTN_R" Content="R" />
                
                <Button Grid.Row="3" Grid.Column="1" Name="BTN_S" Content="S" />
                <Button Grid.Row="3" Grid.Column="2" Name="BTN_T" Content="T" />
                <Button Grid.Row="3" Grid.Column="3" Name="BTN_U" Content="U" />
                <Button Grid.Row="3" Grid.Column="4" Name="BTN_V" Content="V" />
                <Button Grid.Row="3" Grid.Column="5" Name="BTN_W" Content="W" />
                <Button Grid.Row="3" Grid.Column="6" Name="BTN_X" Content="X" />

                <Button Grid.Row="4" Grid.Column="1" Name="BTN_Y" Content="Y" />
                <Button Grid.Row="4" Grid.Column="2" Name="BTN_Z" Content="Z" />
            </Grid>

        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        </Grid>
        <TextBox Grid.Row="0" Name="TB_Display"></TextBox>

    </Grid>
    
</Window>
